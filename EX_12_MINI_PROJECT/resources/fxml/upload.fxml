<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.docuverify.controller.UploadController">
    <!-- Left Navigation Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <Label styleClass="brand-title" text="🛡️ DocuVerify" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboardBtn" onAction="#handleNavDashboard" styleClass="nav-button" text="📊  Dashboard" />
                <Button fx:id="navUploadBtn" onAction="#handleNavUpload" styleClass="nav-button-active" text="📄  Register Document" />
                <Button fx:id="navVerifyBtn" onAction="#handleNavVerify" styleClass="nav-button" text="🔍  Verify Document" />
                <Button fx:id="navHistoryBtn" onAction="#handleNavHistory" styleClass="nav-button" text="📜  Verification History" />
            </VBox>

            <VBox spacing="10.0">
                <VBox style="-fx-background-color: #374151; -fx-background-radius: 8; -fx-padding: 10;">
                    <Label fx:id="userLabel" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;" text="User" />
                    <Label fx:id="roleLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="Role: USER" />
                </VBox>
                <Button onAction="#handleLogout" styleClass="logout-button" text="🚪 Log Out" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Content View -->
    <center>
        <VBox styleClass="content-area" spacing="20.0">
            <VBox spacing="4.0">
                <Label styleClass="page-title" text="Register New Document" />
                <Label styleClass="page-subtitle" text="Upload a document to compute its SHA-256 hash and register it into the database" />
            </VBox>

            <!-- File Selection Card -->
            <VBox styleClass="metric-card" spacing="15.0">
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Button onAction="#handleChooseFile" styleClass="secondary-button" text="📁 Select Document File..." />
                    <Label fx:id="filePathLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="No file selected (PDF, DOCX, TXT, PNG, JPG supported)" />
                </HBox>

                <!-- Metadata Grid -->
                <GridPane hgap="20.0" vgap="10.0" style="-fx-padding: 10 0 0 0;">
                    <Label styleClass="form-label" text="File Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="fileNameVal" style="-fx-text-fill: #60a5fa;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="form-label" text="File Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="fileTypeVal" style="-fx-text-fill: #e5e7eb;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="form-label" text="File Size:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="fileSizeVal" style="-fx-text-fill: #e5e7eb;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="form-label" text="SHA-256 Hash:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="hashValField" editable="false" prefWidth="550.0" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;" promptText="SHA-256 hash will be calculated..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Button fx:id="registerDocBtn" disable="true" onAction="#handleRegisterDocument" styleClass="primary-button" text="🔒 Register Document &amp; Hash" />
                    <ProgressIndicator fx:id="progressIndicator" prefHeight="28.0" prefWidth="28.0" visible="false" />
                </HBox>
            </VBox>

            <!-- Registered Documents Table -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e5e7eb;" text="Registered Documents List" />
                <TableView fx:id="docTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDocId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colDocName" prefWidth="200.0" text="File Name" />
                        <TableColumn fx:id="colDocType" prefWidth="75.0" text="Type" />
                        <TableColumn fx:id="colDocSize" prefWidth="90.0" text="Size" />
                        <TableColumn fx:id="colDocHash" prefWidth="220.0" text="SHA-256 Hash" />
                        <TableColumn fx:id="colDocOwner" prefWidth="130.0" text="Registered By" />
                        <TableColumn fx:id="colDocDate" prefWidth="160.0" text="Timestamp" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
