<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.t2verify.controller.HistoryController">
    <!-- Left Navigation Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <Label styleClass="brand-title" text="🛡️ T2Verify" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboardBtn" onAction="#handleNavDashboard" styleClass="nav-button" text="📊  Dashboard" />
                <Button fx:id="navUploadBtn" onAction="#handleNavUpload" styleClass="nav-button" text="📄  Register Document" />
                <Button fx:id="navVerifyBtn" onAction="#handleNavVerify" styleClass="nav-button" text="🔍  Verify Document" />
                <Button fx:id="navHistoryBtn" onAction="#handleNavHistory" styleClass="nav-button-active" text="📜  Verification History" />
            </VBox>

            <VBox spacing="10.0">
                <VBox style="-fx-background-color: #374151; -fx-background-radius: 8; -fx-padding: 10;">
                    <Label fx:id="userLabel" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;" text="User" />
                    <Label fx:id="roleLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="Role: USER" />
                </VBox>
                <Button onAction="#handleLogout" styleClass="logout-button" text="🚪 Log Out" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Content View -->
    <center>
        <VBox styleClass="content-area" spacing="20.0">
            <VBox spacing="4.0">
                <Label styleClass="page-title" text="Verification Audit History" />
                <Label styleClass="page-subtitle" text="Review previous document verification logs and search audit records" />
            </VBox>

            <!-- Search & Filter Controls -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" prefWidth="300.0" promptText="🔍 Search file name..." />
                <ComboBox fx:id="filterComboBox" prefWidth="180.0" promptText="Filter by Result" />
                <Button onAction="#handleRefresh" styleClass="secondary-button" text="🔄 Refresh" />
            </HBox>

            <!-- History TableView -->
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
                    <TableColumn fx:id="colFileName" prefWidth="200.0" text="Submitted File" />
                    <TableColumn fx:id="colResult" prefWidth="150.0" text="Result" />
                    <TableColumn fx:id="colHash" prefWidth="220.0" text="Submitted Hash" />
                    <TableColumn fx:id="colMatchedDocId" prefWidth="100.0" text="Matched Doc" />
                    <TableColumn fx:id="colVerifier" prefWidth="130.0" text="Verifier" />
                    <TableColumn fx:id="colTimestamp" prefWidth="160.0" text="Verified At" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
