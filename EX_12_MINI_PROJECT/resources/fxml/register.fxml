<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.docuverify.controller.RegisterController">
    <VBox alignment="CENTER" fillWidth="false">
        <VBox styleClass="auth-card" prefWidth="440.0" spacing="12.0">
            <VBox alignment="CENTER" spacing="4.0">
                <Label styleClass="brand-title" text="🛡️ Create Account" />
                <Label styleClass="page-subtitle" text="Register to manage &amp; verify documents" />
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="form-label" text="Full Name" />
                <TextField fx:id="fullNameField" promptText="e.g. Thamizhselvan" />
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="form-label" text="Email Address" />
                <TextField fx:id="emailField" promptText="e.g. thamizhselvan@example.com" />
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="form-label" text="Username" />
                <TextField fx:id="usernameField" promptText="e.g. thamizhselvan" />
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="form-label" text="Password" />
                <PasswordField fx:id="passwordField" promptText="At least 6 characters" />
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="form-label" text="Confirm Password" />
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" />
            </VBox>

            <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-wrap-text: true;" visible="false" />

            <Button fx:id="registerButton" defaultButton="true" onAction="#handleRegister" prefWidth="Infinity" styleClass="primary-button" text="Register Account" />

            <HBox alignment="CENTER" spacing="8.0">
                <Label style="-fx-text-fill: #9ca3af;" text="Already registered?" />
                <Button onAction="#handleGoToLogin" style="-fx-background-color: transparent; -fx-text-fill: #60a5fa; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" text="Log In" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
