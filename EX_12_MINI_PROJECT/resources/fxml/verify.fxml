<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.t2verify.controller.VerificationController">
    <!-- Left Navigation Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <Label styleClass="brand-title" text="🛡️ T2Verify" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboardBtn" onAction="#handleNavDashboard" styleClass="nav-button" text="📊  Dashboard" />
                <Button fx:id="navUploadBtn" onAction="#handleNavUpload" styleClass="nav-button" text="📄  Register Document" />
                <Button fx:id="navVerifyBtn" onAction="#handleNavVerify" styleClass="nav-button-active" text="🔍  Verify Document" />
                <Button fx:id="navHistoryBtn" onAction="#handleNavHistory" styleClass="nav-button" text="📜  Verification History" />
            </VBox>

            <VBox spacing="10.0">
                <VBox style="-fx-background-color: #374151; -fx-background-radius: 8; -fx-padding: 10;">
                    <Label fx:id="userLabel" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;" text="User" />
                    <Label fx:id="roleLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="Role: USER" />
                </VBox>
                <Button onAction="#handleLogout" styleClass="logout-button" text="🚪 Log Out" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Content View -->
    <center>
        <VBox styleClass="content-area" spacing="20.0">
            <VBox spacing="4.0">
                <Label styleClass="page-title" text="Verify Document Authenticity" />
                <Label styleClass="page-subtitle" text="Select any file to check if an exact matching registered document exists in the database" />
            </VBox>

            <!-- File Selection Panel -->
            <VBox styleClass="metric-card" spacing="15.0">
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Button onAction="#handleChooseFile" styleClass="secondary-button" text="📁 Select File to Verify..." />
                    <Label fx:id="filePathLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="No document file selected" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Button fx:id="verifyBtn" disable="true" onAction="#handleVerifyDocument" styleClass="primary-button" text="🔍 Run SHA-256 Verification" />
                    <ProgressIndicator fx:id="progressIndicator" prefHeight="28.0" prefWidth="28.0" visible="false" />
                </HBox>
            </VBox>

            <!-- Verification Result Card (Hidden until verification executed) -->
            <VBox fx:id="resultContainer" styleClass="metric-card" spacing="15.0" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <Label fx:id="resultBadgeLabel" styleClass="badge-verified" text="✓ VERIFIED MATCH" />
                    <VBox>
                        <Label fx:id="resultMessageLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Exact matching document found!" />
                        <Label fx:id="resultSubMessageLabel" style="-fx-text-fill: #9ca3af;" text="The submitted document matches a registered hash in the database." />
                    </VBox>
                </HBox>

                <!-- Detailed Result Grid -->
                <GridPane hgap="20.0" vgap="10.0" style="-fx-padding: 10 0 0 0;">
                    <Label styleClass="form-label" text="Calculated Hash:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="calculatedHashField" editable="false" prefWidth="550.0" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="form-label" text="Matched Document ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="matchedDocIdLabel" style="-fx-text-fill: #60a5fa; -fx-font-weight: bold;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="form-label" text="Original File Name:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="originalFileNameLabel" style="-fx-text-fill: #e5e7eb;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="form-label" text="Registered Owner:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="registeredOwnerLabel" style="-fx-text-fill: #e5e7eb;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label styleClass="form-label" text="Registration Date:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="registrationDateLabel" style="-fx-text-fill: #e5e7eb;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </GridPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
