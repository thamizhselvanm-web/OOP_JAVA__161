<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.docuverify.controller.LoginController">
    <VBox alignment="CENTER" fillWidth="false">
        <VBox styleClass="auth-card" prefWidth="420.0" spacing="15.0">
            <VBox alignment="CENTER" spacing="5.0">
                <Label styleClass="brand-title" text="🛡️ DocuVerify" />
                <Label styleClass="page-subtitle" text="Secure Digital Document Verification System" />
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="form-label" text="Username or Email" />
                <TextField fx:id="usernameField" promptText="Enter username or email" />
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="form-label" text="Password" />
                <PasswordField fx:id="passwordField" promptText="Enter password" />
            </VBox>

            <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-wrap-text: true;" visible="false" />

            <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin" prefWidth="Infinity" styleClass="primary-button" text="Log In" />

            <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 10 0 0 0;">
                <Label style="-fx-text-fill: #9ca3af;" text="Don't have an account?" />
                <Button onAction="#handleGoToRegister" style="-fx-background-color: transparent; -fx-text-fill: #60a5fa; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" text="Register here" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
